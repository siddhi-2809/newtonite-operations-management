# Newtonite Backend Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/newtonite_db
SECRET_KEY=replace-with-a-secure-random-secret-key-minimum-32-chars
ALGORITHM=HS256
